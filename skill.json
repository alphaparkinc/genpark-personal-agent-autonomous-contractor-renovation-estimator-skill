{
  "name": "genpark-personal-agent-autonomous-contractor-renovation-estimator-skill",
  "version": "1.0.0",
  "title": "Contractor Renovation Bidding Audit & Counter-Offer Estimator Skill",
  "description": "Home improvement and commercial renovation contractor quote auditing, regional labor & materials RSMeans benchmarking, scope-of-work discrepancy detection, and automated counter-bidding negotiation synthesis. Built for GenPark (https://www.genpark.ai).",
  "homepage": "https://www.genpark.ai",
  "linkedin": "https://www.linkedin.com/company/92955550",
  "category": "personal-agent",
  "topics": [
    "renovation",
    "contractor-bidding",
    "quote-audit",
    "rsmeans",
    "counter-offer",
    "personal-agent",
    "agentic-commerce",
    "model-context-protocol",
    "genpark"
  ],
  "tools": [
    {
      "name": "audit_contractor_renovation_quote",
      "description": "Audit contractor line-item quote against fair market regional benchmarks, detecting excessive margins (>25%) and hidden scope padding.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string"
          },
          "region_metro_code": {
            "type": "string",
            "description": "e.g. SF_BAY, NYC_METRO, NATIONAL_AVG"
          },
          "quote_total_usd": {
            "type": "number"
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "trade": {
                  "type": "string",
                  "enum": [
                    "demolition",
                    "electrical",
                    "plumbing",
                    "framing",
                    "drywall",
                    "tile_flooring",
                    "cabinets_millwork",
                    "painting",
                    "general_conditions"
                  ]
                },
                "quoted_cost_usd": {
                  "type": "number"
                },
                "square_footage": {
                  "type": "number"
                }
              },
              "required": [
                "trade",
                "quoted_cost_usd"
              ]
            }
          }
        },
        "required": [
          "project_name",
          "quote_total_usd",
          "line_items"
        ]
      }
    },
    {
      "name": "synthesize_contractor_counter_bid",
      "description": "Generate an evidence-backed counter-bid negotiation dossier with rationalized target contract sum and payment milestone escrow schedule.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contractor_name": {
            "type": "string"
          },
          "original_quote_usd": {
            "type": "number"
          },
          "audited_fair_market_usd": {
            "type": "number"
          },
          "target_counter_offer_usd": {
            "type": "number"
          },
          "flagged_trades": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "contractor_name",
          "original_quote_usd",
          "audited_fair_market_usd",
          "target_counter_offer_usd"
        ]
      }
    }
  ]
}